<%- include('partials/navbar') %>

    <table>
        <tr>
            <th width="150px">Pranchas</th>
            <th>Medidas</th>
            <th>Preço</th>
        </tr>
         <% Pranchas.forEach(Pranchas => { %>
            <tr>
                <td><div style="overflow: hidden; width: 200px; height: 200px;"><img src="<%= Pranchas.imagem %>" alt="" height="200px"></div></td>
                <td><%= Pranchas.medidas %></td>
                <td><%= Pranchas.preco %></td>
            </tr>
         <%})%>
      </table>    

<%- include('partials/footer') %>
<%- include('Partials/navbar.ejs') %>

    <table>
        <tr>
            <th>Patrocinados</th>
            <th width="150px">Nome</th>
            <th>Vitórias</th>
        </tr>
         <% Patrocinados.forEach(Patrocinados => { %>
            <tr>
                <td><div style="overflow: hidden; width: 200px; height: 200px;"><img src="<%= Patrocinados.imagem %>" alt="" width="200px"></div></td>
                <td><%= Patrocinados.nome %></td>
                <td><%= Patrocinados.vitorias %></td>
            </tr>
         <%})%>
      </table>

<%- include('Partials/footer.ejs') %>
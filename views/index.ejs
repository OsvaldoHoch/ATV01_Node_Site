<%- include('Partials/navbar.ejs') %>

    <Header class="header">
        <img src="/images/BrandNew-Skateshop-and-Pranchas-logo.png" alt="" width="400px" style="z-index: 10;">
        <div class="header-background"><img src="/images/ondas-header.png" alt="" width="500px"></div>
        <div class="header-content">
            <h1>Chega junto na BrandNew Skate & Surf!</h1>
            <a href="/skates"><button class="btn-header">Conheça nossos produtos</button></a>
        </div>
    </Header>

    <div class="skateshop">
        <div class="skate-ver-mais">
            <h3><span style="font-size: 50px;">SKATE</span> - <a href="/skates">Ver mais ></a></h3>
            
        </div>
        <div class="skate-imgs">
            <div class="skate-img">
                <img src="/images/Skate-01.jpeg" alt="Skate-01">
            </div>
            <div class="skate-img">
                <img src="/images/Skate-02.jpeg" alt="Skate-01" style="width: 400px; transform: translateY(-1px);">
            </div>
            <div class="skate-img">
                <img src="/images/Skate-03.jpeg" alt="Skate-01" style="transform: translateY(-40px);">
            </div>
            <div class="skate-img">
                <img src="/images/Skate-04.jpeg" alt="Skate-01" style="width: 500px; transform: translateY(-100px); transform: translateX(-40px -40px);">
            </div>
            <div class="skate-img">
                <img src="/images/Skate-05.jpeg" alt="Skate-01" style="width: 320px; transform: rotate(-90deg);">
            </div>
        </div>
    </div>
    <div class="Surfshop">
        <div class="surf-ver-mais">
            <h3><span style="font-size: 50px;">SURF</span> - <a href="/pranchas">Ver mais ></a></h3>
        </div>
        <div class="surf-imgs">
            <div class="surf-img">
                <img src="/images/Surf-01.jpeg" alt="Skate-01" style="">
            </div>
            <div class="surf-img">
                <img src="/images/Surf-07.jpeg" alt="Skate-01" style="width: 600px; transform: translateX(-200px);">
            </div>
            <div class="surf-img">
                <img src="/images/Surf-04.jpeg" alt="Skate-01" style="width: 600px;transform: translateX(-100px);">
            </div>
            <div class="surf-img">
                <img src="/images/Osvaldo&Davi.jpeg" alt="Skate-01" style="width: 400px; transform: translateX(-50px);">
            </div>
            <div class="surf-img">
                <img src="/images/Surf-06.jpeg" alt="Skate-01" style="width: 600px; transform: translateX(-170px);">
            </div>
        </div>
    </div>

<%- include('Partials/footer.ejs') %>

<%- include('partials/navbar.ejs') %>

    <table>
        <tr>
            <th width="150px">Skates</th>
            <th>Medidas</th>
            <th>Preço</th>
        </tr>
         <% Skates.forEach(Skates => { %>
            <tr>
                <td><div style="overflow: hidden; width: 200px; height: 200px;"><img src="<%= Skates.imagem %>" alt="" height="200px"></div></td>
                <td><%= Skates.medidas %></td>
                <td><%= Skates.preco %></td>
            </tr>
         <%})%>
      </table>  

<%- include('partials/footer.ejs') %>